{
	"extends": [ "config:recommended" ],

	"automerge": true,
	"automergeType": "pr",
	"automergeStrategy": "squash",

	"prConcurrentLimit": 1,

	"packageRules": [
		{
			"matchPackagePatterns": [ "*" ],
			"groupName": "all dependencies",
			"groupSlug": "all-deps",
			"automerge": true
		},
		{
			"matchManagers": [ "pip", "github-actions" ],
			"rangeStrategy": "replace"
		}
	],

	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
			"datasourceTemplate": "github-tags",
			"depNameTemplate": "actions/setup-python",
			"versioningTemplate": "pep440",
			"matchStrings": [
				"python-version:\\s*(?<currentValue>\\d+\\.\\d+)",
				"Set up Python\\s+(?<currentValue>\\d+\\.\\d+)"
			]
		}
	]

	"pip_requirements": {
		"fileMatch": [
			"(^|/)requirements\\.txt$",
			"(^|/)requirements/.*\\.txt$",
			"(^|/)\\.github/.*requirements.*\\.txt$",
			"^\\.github/debci\\.txt$",
			"^\\.github/pythonchecks\\.txt$"
		]
	}
}
